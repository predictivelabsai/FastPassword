# Copy these entries into the ignored .env; never commit real values.
COOLIFY_BASE_URL=https://coolify.fastsme.com
COOLIFY_API_TOKEN=

# Database backend: postgresql (default) | sqlite
DB_TYPE=postgresql
DB_SCHEMA=fast_password
# DATABASE_URL falls back to DATABASE_URL_PROD if unset. postgres:// is accepted.
DATABASE_URL=
DATABASE_URL_PROD=
# For DB_TYPE=sqlite instead:
# FASTPASSWORD_DB=data/fastpassword.sqlite

# App
FASTPASSWORD_SECRET=
FASTPASSWORD_PORT=5031
FASTPASSWORD_PUBLIC_URL=https://password.fastsme.com
FASTSME_PUBLIC_URL=https://password.fastsme.com

# CRITICAL vault recovery key — generate with `python -m fastpassword.crypto genkey`.
# Losing it makes every vault permanently undecryptable; back it up out of band.
FASTPASSWORD_RECOVERY_KEY=
FASTPASSWORD_OLD_DAYS=365

# Google SSO (shared FastSME OAuth client; add this app's /auth/callback redirect URI)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ALLOWED_DOMAINS=

# Local-account email (optional; Postmark). Blank = email flows disabled.
POSTMARK_API_TOKEN=
FROM_EMAIL=
